      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "avg by (build, phase) (last_over_time(lab_boot_seconds{build=~\"$build\"}[$__range]))",
          "legendFormat": "",
          "refId": "A",
          "format": "table",
          "instant": true,
          "range": false
