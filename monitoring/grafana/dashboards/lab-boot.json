      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "avg by (build, fn) (last_over_time(lab_boot_initcall_seconds{build=~\"$build\"}[$__range])) and on (fn) (max by (fn) (avg by (build, fn) (last_over_time(lab_boot_initcall_seconds{build=~\"$build\"}[$__range]))) > 0.0005)",
          "legendFormat": "",
