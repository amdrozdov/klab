{
  "uid": "lab-boot",
  "title": "klab \u2014 Boot",
  "description": "Boot process traces from lab boottrace",
  "tags": [
    "klab"
  ],
  "editable": true,
  "schemaVersion": 41,
  "version": 1,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "",
  "timepicker": {
    "refresh_intervals": [
      "1s",
      "5s",
      "10s",
      "30s",
      "1m"
    ]
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "klab"
      ],
      "asDropdown": false,
      "title": "klab",
      "includeVars": true,
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "build",
        "label": "Build",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "query": {
          "query": "label_values(lab_boot_info, build)",
          "refId": "build"
        },
        "definition": "label_values(lab_boot_info, build)",
        "multi": true,
        "includeAll": true,
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "boot",
        "label": "Boot",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "query": {
          "query": "label_values(lab_boot_info{build=~\"$build\"}, run)",
          "refId": "boot"
        },
        "definition": "label_values(lab_boot_info{build=~\"$build\"}, run)",
        "multi": false,
        "includeAll": false,
        "refresh": 2,
        "sort": 2,
        "hide": 0
      },
      {
        "name": "trace_id",
        "label": "trace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "query": {
          "query": "label_values(lab_boot_info{run=\"$boot\"}, trace_id)",
          "refId": "trace_id"
        },
        "definition": "label_values(lab_boot_info{run=\"$boot\"}, trace_id)",
        "multi": false,
        "includeAll": false,
        "refresh": 2,
        "sort": 1,
        "hide": 2
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "panels": [
    {
      "type": "text",
      "title": "",
      "options": {
        "mode": "markdown",
        "content": "Every step of a boot, recorded by `lab boottrace` (initcall tracepoints, kernel log milestones, systemd unit timestamps). Pick a **boot** above for the waterfall: click a span \u2192 *Span attributes* \u2192 **link.vscode** opens the function in your local tree, **link.elixir** on elixir.bootlin.com (systemd units: **link.docs**). The *kernel* span's events are kernel-log milestones. Compare builds at the bottom. Phases: pre-kernel (QEMU + firmware + decompression, host-measured, approx.) \u2192 kernel (`start_kernel` \u2192 initcall levels \u2192 root mount) \u2192 userspace (systemd units)."
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      }
    },
    {
      "type": "row",
      "title": "Selected boot",
      "collapsed": false,
      "panels": [],
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "stat",
      "title": "Phases",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "last_over_time(lab_boot_seconds{run=\"$boot\"}[$__range])",
          "legendFormat": "{{phase}}",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value_and_name",
        "colorMode": "none",
        "graphMode": "none",
        "orientation": "vertical",
        "text": {
          "titleSize": 14,
          "valueSize": 28
        }
      },
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 18,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Initcalls",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "count(last_over_time(lab_boot_initcall_seconds{run=\"$boot\"}[$__range]))",
          "legendFormat": "initcalls",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "none"
      },
      "id": 4,
      "gridPos": {
        "x": 18,
        "y": 4,
        "w": 6,
        "h": 4
      }
    },
    {
      "type": "traces",
      "title": "Boot waterfall",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "${trace_id}",
          "refId": "A",
          "limit": 20
        }
      ],
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 24
      }
    },
    {
      "type": "table",
      "title": "Slowest initcalls",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "topk(30, last_over_time(lab_boot_initcall_seconds{run=\"$boot\"}[$__range]))",
          "legendFormat": "",
          "refId": "A",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "kind": true,
              "run": true,
              "build": true
            },
            "renameByName": {
              "Value": "time"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "mappings": []
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "time"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "gradient"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "time",
            "desc": true
          }
        ]
      },
      "id": 6,
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 12
      }
    },
    {
      "type": "barchart",
      "title": "Time per initcall level",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "last_over_time(lab_boot_level_seconds{run=\"$boot\"}[$__range])",
          "legendFormat": "",
          "refId": "A",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "run": true,
              "build": true
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "level",
                "desc": false
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "xField": "level",
        "orientation": "horizontal",
        "showValue": "auto",
        "legend": {
          "showLegend": false
        }
      },
      "id": 7,
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 12
      }
    },
    {
      "type": "table",
      "title": "Slowest systemd units",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "topk(25, last_over_time(lab_boot_unit_seconds{run=\"$boot\"}[$__range]))",
          "legendFormat": "",
          "refId": "A",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "kind": true,
              "run": true,
              "build": true
            },
            "renameByName": {
              "Value": "time"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "time",
            "desc": true
          }
        ]
      },
      "id": 8,
      "gridPos": {
        "x": 0,
        "y": 44,
        "w": 24,
        "h": 10
      }
    },
    {
      "type": "row",
      "title": "Compare builds (all boots of the selected builds in range)",
      "collapsed": false,
      "panels": [],
      "id": 9,
      "gridPos": {
        "x": 0,
        "y": 54,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "timeseries",
      "title": "Boot phases per boot",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "lab_boot_seconds{build=~\"$build\", phase!=\"total\"}",
          "legendFormat": "{{phase}} {{build}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "points",
            "lineWidth": 1,
            "pointSize": 6,
            "fillOpacity": 5,
            "showPoints": "always",
            "spanNulls": false,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "min",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 10,
      "gridPos": {
        "x": 0,
        "y": 55,
        "w": 24,
        "h": 8
      }
    },
    {
      "type": "table",
      "title": "Phase averages by build",
