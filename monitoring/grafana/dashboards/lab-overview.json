{
  "uid": "lab-overview",
  "title": "klab \u2014 Overview",
  "description": "Guest kernel, host and QEMU telemetry for klab runs",
  "tags": [
    "klab"
  ],
  "editable": true,
  "schemaVersion": 41,
  "version": 1,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "5s",
  "timepicker": {
    "refresh_intervals": [
      "1s",
      "5s",
      "10s",
      "30s",
      "1m"
    ]
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "klab"
      ],
      "asDropdown": false,
      "title": "klab",
      "includeVars": true,
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "build",
        "label": "Build",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "query": {
          "query": "label_values(up{job=~\"guest-.*\"}, build)",
          "refId": "build"
        },
        "definition": "label_values(up{job=~\"guest-.*\"}, build)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "refresh": 2,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      },
      {
        "name": "run",
        "label": "Run",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "query": {
          "query": "label_values(up{job=~\"guest-.*\", build=~\"$build\"}, run)",
          "refId": "run"
        },
        "definition": "label_values(up{job=~\"guest-.*\", build=~\"$build\"}, run)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "refresh": 2,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 2
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Benchmark iterations",
        "enable": true,
        "iconColor": "#F2CC0C",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "target": {
          "type": "tags",
          "tags": [
            "lab-iter"
          ],
          "matchAny": false,
          "limit": 2000
        }
      },
      {
        "name": "VM sessions",
        "enable": true,
        "iconColor": "#8AB8FF",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "target": {
          "type": "tags",
          "tags": [
            "lab-session"
          ],
          "matchAny": false,
          "limit": 500
        }
      }
    ]
  },
  "panels": [
    {
      "type": "text",
      "title": "",
      "options": {
        "mode": "markdown",
        "content": "Telemetry from `lab bench run` / `lab boot` while the observe stack is up. **Yellow regions** = benchmark iterations, **blue** = VM sessions (toggle at the top). Pick builds/runs above; guest panels are the kernel under test, *Host & QEMU* shows whether the host added noise. eBPF metrics: see **klab \u2014 eBPF**."
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      }
    },
    {
      "type": "row",
      "title": "Runs & results",
      "collapsed": false,
      "panels": [],
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "table",
      "title": "Guest kernels in range",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "last_over_time(node_uname_info{job=\"guest-node\", build=~\"$build\", run=~\"$run\"}[$__range])",
          "legendFormat": "",
          "refId": "A",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "kind": true,
              "domainname": true,
              "machine": true,
              "sysname": true,
              "nodename": true
            },
            "renameByName": {
              "Value": "up"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 10,
        "h": 7
      }
    },
    {
      "type": "table",
      "title": "Benchmark medians (runs in range)",
