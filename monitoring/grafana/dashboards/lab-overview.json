    {
      "type": "timeseries",
      "title": "Per-iteration results",
      "description": "One point per benchmark iteration, at the time it finished",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "lab_bench_value{build=~\"$build\", run=~\"$run\"}",
          "legendFormat": "{{bench}}/{{metric}} [{{unit}}] {{build}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "points",
            "lineWidth": 1,
            "pointSize": 6,
            "fillOpacity": 5,
            "showPoints": "always",
            "spanNulls": false,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 24,
        "h": 8
