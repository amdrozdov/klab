# Merged into every `lab build --arch pi` build (Raspberry Pi 4).
#
# The base is normally the stock Raspberry Pi OS config (`--base-config pi`), which
# already has all of this. This fragment is the safety net for the other bases (arm64
# defconfig, a path, a URL): the Pi kernel is started without an initramfs, so
# everything needed to reach the root filesystem and the network must be built in.
# Wi-Fi (brcmfmac) stays a module; it loads from the root filesystem.

# SoC, SD card (Pi 4 uses the sdhci-iproc "emmc2" controller), root and boot filesystems
CONFIG_ARCH_BCM2835=y
CONFIG_MMC_SDHCI_IPROC=y
CONFIG_MMC_BCM2835=y
CONFIG_BLK_DEV_SD=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y

# USB (the Pi 4's USB 3 controller sits behind PCIe): boot from or use USB storage
CONFIG_PCIE_BRCMSTB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_STORAGE=y

# Ethernet (the PHY driver is needed too) and Wi-Fi
CONFIG_BCMGENET=y
CONFIG_BROADCOM_PHY=y
CONFIG_CFG80211=m
CONFIG_BRCMFMAC=m

# /proc/config.gz on the Pi, so a running kernel can always show its own config
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
