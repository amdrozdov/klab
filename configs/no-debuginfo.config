# Drop DWARF debug info (and BTF, which depends on it) to roughly halve build size
# and disk use. Applied last via `lab build --no-debug-info`, so it overrides the
# base config / profile. Debug info only affects the build, not the running kernel;
# you lose source-level gdb and BTF-based eBPF (fine for a config/boot validation).
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO_BTF is not set
