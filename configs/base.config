# Applied to every build, on top of `make defconfig kvm_guest.config`.
# Observability you want regardless of profile.

# /proc/config.gz inside the guest
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_KALLSYMS_ALL=y

# ftrace / kprobes / perf / eBPF
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_FUNCTION_GRAPH_TRACER=y
CONFIG_DYNAMIC_FTRACE=y
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_UPROBE_EVENTS=y
CONFIG_PERF_EVENTS=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_EVENTS=y
CONFIG_DEBUG_FS=y
CONFIG_SCHEDSTATS=y

# VM plumbing: virtio disk, 9p shares (/mnt/lab, /lib/modules)
CONFIG_VIRTIO_BLK=y
CONFIG_EXT4_FS=y
CONFIG_9P_FS=y
CONFIG_9P_FS_POSIX_ACL=y
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_IO_URING=y

# BTF type info: required by eBPF CO-RE tools (ebpf_exporter, bpftrace, libbpf-tools).
# Pulls in DWARF at build time (needs `pahole` on the host); no runtime cost.
# CONFIG_DEBUG_INFO_NONE is not set
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
CONFIG_DEBUG_INFO_COMPRESSED_ZLIB=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_DEBUG_INFO_BTF_MODULES=y

# Pressure stall info (/proc/pressure): CPU/memory/IO stall time, shown on the dashboard.
CONFIG_PSI=y
