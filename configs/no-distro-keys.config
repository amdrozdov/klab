# Distro configs point the trusted/revocation key options at packaging files that
# only exist in the distro's own source tree (e.g. Ubuntu's debian/canonical-certs.pem),
# so a vanilla kernel.org build dies at the certs step:
#   No rule to make target 'debian/canonical-certs.pem', needed by certs/...
# Clear them for lab builds (--base-config, unless --raw). Module signing itself still
# works: an empty SYSTEM_TRUSTED_KEYS is fine, and MODULE_SIG_KEY auto-generates a key.
CONFIG_SYSTEM_TRUSTED_KEYS=""
CONFIG_SYSTEM_REVOCATION_KEYS=""
