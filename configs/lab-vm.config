# Merged on top of a --base-config full config (unless --raw) so the kernel still
# boots the lab's QEMU VM (Gate 1). A distro config ships these as modules, which
# the lab's "modules over 9p" boot can't load early enough -- force them built-in:
# virtio transport + devices, ext4 root, the 9p shares (/mnt/lab, /lib/modules),
# virtio-rng, and the ttyS0 serial console the lab boots on.
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_EXT4_FS=y
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_9P_FS=y
CONFIG_9P_FS_POSIX_ACL=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
